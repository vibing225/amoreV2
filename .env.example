# Copy this file to ".env" and fill in the values. Never commit ".env".

# "production" on the server. Set APP_DEBUG=true only on your own computer.
APP_ENV=production
APP_DEBUG=false

# Public address of the site, no trailing slash (used in emails).
APP_URL=

# Only needed under XAMPP like http://localhost/amore-mio-v2.0
# Leave empty when the domain root is public/.
APP_BASE_PATH=

# Set to true once https:// works on your domain, to redirect http:// to https://.
FORCE_HTTPS=false

# Where the contact and partner emails are delivered.
OWNER_EMAIL=

# SMTP account used to send the emails.
SMTP_HOST=
SMTP_PORT=587
# tls (port 587) or ssl (port 465)
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME when empty.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="AMORE MIO"

# Optional: override the contact details shown in the footer.
SITE_PHONE=
SITE_EMAIL=
SITE_ADDRESS=
